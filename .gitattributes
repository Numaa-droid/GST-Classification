# Force LF everywhere, on every platform.
#
# This is not cosmetic. Every build in this repo is byte-for-byte reproducible
# and the reports quote SHA-256 hashes. With core.autocrlf=true (the Windows
# default, and what is set on this machine) Git would hand out CRLF on checkout,
# every hash would differ from the one in the reports, and the reproducibility
# guarantee would silently stop being checkable.
#
# The scripts always write LF, so this keeps the working tree and the repo in
# agreement and produces no spurious diffs.

* text=auto eol=lf

*.jsonl  text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.py     text eol=lf
*.html   text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.txt    text eol=lf

# Never touch these
*.png    binary
*.jpg    binary
*.pdf    binary
*.xlsx   binary
*.pyc    binary

# Large reference data — one long line per record, don't try to diff it
"merged 1.jsonl" -diff
